// MangoUI theme: the tokens and base styles of theme.module.css, and the choice between the light
// and the dark one. Without a choice the page follows the system; the choice is kept in
// localStorage and applied before the page is drawn.

import "./theme.module.css"
import { IconButton } from "./button.mango"

export type ThemeMode "auto" | "light" | "dark"

const KEY = "mango-theme"

/** The saved choice; "auto" without one, or where storage is not available. */
func savedMode() ThemeMode {
    try {
        switch localStorage.getItem(KEY) {
        case "light":
            return "light"
        case "dark":
            return "dark"
        }
    } catch {
        return "auto"
    }
    return "auto"
}

func apply(mode ThemeMode) {
    const root = document.documentElement
    if mode == "auto" {
        root.removeAttribute("data-theme")
    } else {
        root.setAttribute("data-theme", mode)
    }
}

/** Applies the saved theme: call it before the page is drawn, so that it does not flash. */
export func applyTheme() {
    apply(savedMode())
}

/** The names of the modes for the button, in the language of the page. */
export interface ThemeLabels {
    auto string
    light string
    dark string
}

/** A button that goes through the modes: auto → light → dark. */
export comp ThemeToggle(labels ThemeLabels) {
    state mode = savedMode()

    func next() {
        mode = mode == "auto" ? "light" : mode == "light" ? "dark" : "auto"
        apply(mode)
        try {
            if mode == "auto" {
                localStorage.removeItem(KEY)
            } else {
                localStorage.setItem(KEY, mode)
            }
        } catch {
        }
    }

    return <IconButton
        icon={mode == "auto" ? "monitor" : mode == "light" ? "sun" : "moon"}
        label={labels[mode]}
        onPress={next()}
    />
}
