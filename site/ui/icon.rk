// RookUI icons: SVG paths on a 24 × 24 grid, drawn with the color of the text. The GitHub mark is
// the one of Octicons (MIT), filled on its own 16 × 16 grid.

export type IconName "copy" | "check" | "play" | "menu" | "close" | "arrow-right" | "external" |
    "github" | "info" | "lightbulb" | "alert" | "code" | "zap" | "shield" | "layers" | "cpu" |
    "search" | "chevron-left" | "chevron-right" | "chevron-down" | "terminal" | "share" | "refresh" |
    "book" | "package"

interface Shape {
    paths []string
    /** Octicons are filled on a 16 × 16 grid; the others are lines on 24 × 24. */
    filled bool
}

func line(paths []string) Shape {
    return { paths: paths, filled: false }
}

// Read by an IconName: every name is a field.
const SHAPES = {
    copy: line([
        "M11 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z",
        "M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1",
    ]),
    check: line(["M20 6 9 17l-5-5"]),
    play: line(["M7 4.5v15l12-7.5z"]),
    menu: line(["M4 6h16M4 12h16M4 18h16"]),
    close: line(["M18 6 6 18M6 6l12 12"]),
    "arrow-right": line(["M5 12h14M13 5l7 7-7 7"]),
    external: line(["M15 3h6v6M10 14 21 3", "M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"]),
    github: {
        paths: [
            "M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z",
        ],
        filled: true,
    },
    info: line(["M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0z", "M12 16v-4M12 8h.01"]),
    lightbulb: line(["M9 18h6M10 22h4", "M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"]),
    alert: line(["M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z", "M12 9v4M12 17h.01"]),
    code: line(["M16 18l6-6-6-6M8 6l-6 6 6 6"]),
    zap: line(["M13 2 3 14h9l-1 8 10-12h-9l1-8z"]),
    shield: line(["M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z", "M9 12l2 2 4-4"]),
    layers: line(["M12 2 2 7l10 5 10-5-10-5z", "M2 17l10 5 10-5M2 12l10 5 10-5"]),
    cpu: line([
        "M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z",
        "M9 9h6v6H9z",
        "M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3",
    ]),
    search: line(["M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0z", "M21 21l-4.3-4.3"]),
    "chevron-left": line(["M15 18l-6-6 6-6"]),
    "chevron-right": line(["M9 18l6-6-6-6"]),
    "chevron-down": line(["M6 9l6 6 6-6"]),
    terminal: line(["M4 17l6-6-6-6M12 19h8"]),
    share: line(["M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8", "M16 6l-4-4-4 4M12 2v13"]),
    refresh: line(["M3 12a9 9 0 0 1 15.5-6.2L21 8", "M21 3v5h-5", "M21 12a9 9 0 0 1-15.5 6.2L3 16", "M3 21v-5h5"]),
    book: line(["M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14z", "M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"]),
    package: line([
        "M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7z",
        "M3.3 7 12 12l8.7-5M12 22V12",
    ]),
}

/** An icon of `size` pixels; it is decoration, so screen readers skip it. */
export comp Icon(name IconName, size number = 18) {
    derived shape = SHAPES[name]
    return <svg
        viewBox={shape.filled ? "0 0 16 16" : "0 0 24 24"}
        width={size}
        height={size}
        fill={shape.filled ? "currentColor" : "none"}
        stroke={shape.filled ? "none" : "currentColor"}
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
    >
        {for d in shape.paths {
            <path d={d} />
        }}
    </svg>
}
