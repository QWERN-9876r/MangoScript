// RookUI buttons: Button and IconButton are a <button>, LinkButton and IconLink a link that looks
// like one. The attributes of the element (`onClick`, `disabled`, `type`, `aria-*`...) go on it
// through ...attrs.

import styles from "./button.module.css"
import { Icon, IconName } from "./icon.rk"

export type ButtonKind "primary" | "secondary" | "ghost"

export type ButtonSize "sm" | "md" | "lg"

export comp Button(
    kind ButtonKind = "secondary",
    size ButtonSize = "md",
    icon ?IconName = null,
    children Content,
    ...attrs
) {
    return <button class={`${styles.button} ${styles[kind]} ${styles[size]}`} type="button" {...attrs}>
        {icon != null ? <Icon name={icon} /> : null}
        {children}
    </button>
}

export comp LinkButton(
    href string,
    kind ButtonKind = "secondary",
    size ButtonSize = "md",
    icon ?IconName = null,
    children Content,
    ...attrs
) {
    return <a class={`${styles.button} ${styles[kind]} ${styles[size]}`} href={href} {...attrs}>
        {icon != null ? <Icon name={icon} /> : null}
        {children}
    </a>
}

/** A round button with an icon; its label is for screen readers and shown as a tooltip. */
export comp IconButton(
    icon IconName,
    label string,
    kind ButtonKind = "ghost",
    size ButtonSize = "md",
    ...attrs
) {
    return <button
        class={`${styles.button} ${styles.icon} ${styles[kind]} ${styles[size]}`}
        type="button"
        aria-label={label}
        title={label}
        {...attrs}
    >
        <Icon name={icon} />
    </button>
}

/** A round link with an icon, like IconButton. */
export comp IconLink(
    icon IconName,
    label string,
    href string,
    kind ButtonKind = "ghost",
    size ButtonSize = "md",
    ...attrs
) {
    return <a
        class={`${styles.button} ${styles.icon} ${styles[kind]} ${styles[size]}`}
        href={href}
        aria-label={label}
        title={label}
        {...attrs}
    >
        <Icon name={icon} />
    </a>
}
