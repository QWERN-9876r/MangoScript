const fruits = ["mango", "papaya", "lychee", "passion fruit"]

// if, for and switch inside {...}: the elements in their blocks become the content
document.body.append(<ul>
    {for i, fruit in fruits {
        if fruit.length > 5 {
            <li>{i + 1}. {fruit}</li>
        } else {
            <li><s>{fruit}</s>: a short name</li>
        }
    }}
</ul>)
