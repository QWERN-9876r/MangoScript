// go runs a function as a goroutine, in another thread; it gets copies of the arguments
func isPrime(n number) bool {
    if n < 2 {
        return false
    }

    for let d = 2; d * d <= n; d++ {
        if n % d == 0 {
            return false
        }
    }
    return true
}

// What countPrimes uses, isPrime, goes to the other thread with it
func countPrimes(from, to number) number {
    let count = 0
    for let n = from; n < to; n++ {
        if isPrime(n) {
            count++
        }
    }
    return count
}

const PART = 1_000_000

let started = Date.now()
console.log("one thread:", countPrimes(0, 10 * PART), `${Date.now() - started} ms`)

// go gives a Promise of the result: the ten parts are counted at once
started = Date.now()
const parts = await Promise.all(Array(10).fill(0).map((_, i) => go countPrimes(i * PART, (i + 1) * PART)))
console.log("ten goroutines:", parts.reduce((a, b) => a + b, 0), `${Date.now() - started} ms`)