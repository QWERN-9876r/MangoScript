// go for splits an array among the processors: each part runs as a
// goroutine, and the loop waits for all of them
const pixels = new Uint8ClampedArray(1_000_000)
for i, _ in pixels {
    pixels[i] = i % 256
}

const contrast = 1.5
go for i, v in pixels {
    pixels[i] = (v - 128) * contrast + 128
}
console.log("contrast:", pixels[100], pixels[200])

// the body writes only its own element; neighbours come from another array
async func smooth(values []number) []number {
    const out = values.map(_ => 0)
    go for i, _ in out {
        const left = values[Math.max(i - 1, 0)]
        const right = values[Math.min(i + 1, values.length - 1)]
        out[i] = (left + values[i] + right) / 3
    }
    return out
}

console.log("smooth:", await smooth([3, 6, 9, 12, 15]))
