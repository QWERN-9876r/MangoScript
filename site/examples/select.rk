// select waits for the first of several operations on channels;
// after(ms) is a channel that gets the time once, after ms

// out chan<- string only sends: search cannot receive from it
async func search(query string, ms number, out chan<- string) {
    <-after(ms) // as if over the network
    out <- `results for "${query}" in ${ms} ms`
}

// Waiting needs no other thread: an async call without await runs in this thread.
// Room for one answer: a search that nobody waits for can still finish
const fast = chan<string>(1)
const slow = chan<string>(1)
search("guava", 100, fast)
search("papaya", 2000, slow)

// The first answer wins; a timeout stops waiting
for let i = 0; i < 2; i++ {
    select {
    case text = <-fast:
        console.log(text)
    case text = <-slow:
        console.log(text)
    case <-after(500):
        console.log("timeout: 500 ms")
    }
}

// default runs when nothing is ready at once
select {
case text = <-slow:
    console.log(text)
default:
    console.log("slow is not ready yet")
}

// A null channel turns its case off: each search is waited for once
let lime ?chan string = chan<string>(1)
let kiwi ?chan string = chan<string>(1)
search("lime", 80, lime)
search("kiwi", 40, kiwi)
for lime != null || kiwi != null {
    select {
    case text = <-lime:
        console.log(text)
        lime = null
    case text = <-kiwi:
        console.log(text)
        kiwi = null
    }
}
