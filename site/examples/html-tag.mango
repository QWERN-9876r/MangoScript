// @html-tag turns a component into a web component: <fruit-badge> works in any HTML,
// even without MangoScript. Its markup is in a shadow root: the styles of the page do
// not get in, except inherited ones like color and CSS variables like --accent-soft
const STYLE = `
    span { padding: 2px 10px; border-radius: 999px; background: var(--accent-soft) }
    .ripe { font-weight: bold }
`

@html-tag("fruit-badge")
comp FruitBadge(name string, count number = 1, ripe bool) {
    return <>
        <style>{STYLE}</style>
        <span class={ripe ? "ripe" : ""}>{name}: {count}</span>
    </>
}

// From JS it is an element like any other. Attributes are text: count="3" becomes the
// number 3, and ripe is true because the attribute is there
const badge = document.createElement("fruit-badge")
badge.setAttribute("name", "Mango")
badge.setAttribute("count", "3")
badge.setAttribute("ripe", "")
document.body.append(badge)

// Markup sets the properties as they are, and the element follows the state
comp Basket() {
    state kiwis = 1
    return <p>
        <fruit-badge name="Kiwi" count={kiwis} />
        {" "}<button onClick={kiwis++}>One more kiwi</button>
    </p>
}

document.body.append(<Basket />)
