// An iterator is a function with a yield parameter, as in Go 1.23; for goes over it
func fibonacci() func(yield func(number) bool) {
    return func(yield func(number) bool) {
        let a, b = 0, 1
        for {
            // false: the loop over it has stopped, so the iterator ends too
            if !yield(a) {
                return
            }
            a, b = b, a + b
        }
    }
}

for n in fibonacci() {
    if n > 50 {
        break
    }
    console.log(n)
}

// A yield of two values gives a key and a value
func numbered(words []string) func(yield func(number, string) bool) {
    return func(yield func(number, string) bool) {
        for i, word in words {
            if !yield(i + 1, word) {
                return
            }
        }
    }
}

for place, fruit in numbered(["guava", "papaya", "lychee"]) {
    console.log(place, fruit)
}

// It compiles to a JS generator: called, it gives a lazy JS iterator
const evens = fibonacci()().filter(n => n % 2 == 0).take(5).toArray()
console.log("even:", evens.join(", "))
