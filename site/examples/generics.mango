// Параметр типа T: функция работает с массивом любых значений и знает тип результата
func last[T any](xs []T) ?T {
    return xs.length > 0 ? xs[xs.length - 1] : null
}

const fruit = last(["манго", "личи"])     // ?string
const count = last([1, 2, 3])            // ?number

// Ограничение: T подходит под Named, поэтому у x есть name
interface Named {
    name string
}

func names[T Named](items []T) string {
    return items.map(x => x.name).join(", ")
}

// Обобщённый класс; аргумент типа выводится из объявления переменной
class Stack[T] {
    private items []T

    push(item T) {
        this.items.push(item)
    }

    pop() ?T {
        return this.items.pop() ?? null
    }
}

let stack Stack[string] = new Stack()
stack.push("папайя")
console.log(fruit, count, names([{ name: "Аня", age: 30 }]), stack.pop())
// stack.push(1) — ошибка компиляции: нужен string
