// select waits for the first of several operations on channels
func after(ms number) chan bool {
    const ch = chan[bool](1)
    setTimeout(async () => {
        ch <- true
    }, ms)
    return ch
}

async func search(query string, ms number, out chan string) {
    <-after(ms) // as if over the network
    out <- `results for "${query}" in ${ms} ms`
}

// Room for one answer: a search that nobody waits for can still finish
const fast = chan[string](1)
const slow = chan[string](1)
go search("mango", 100, fast)
go search("papaya", 2000, slow)

// The first answer wins; a timeout stops waiting
for let i = 0; i < 2; i++ {
    select {
    case text = <-fast:
        console.log(text)
    case text = <-slow:
        console.log(text)
    case <-after(500):
        console.log("timeout: 500 ms")
    }
}

// default runs when nothing is ready at once
select {
case text = <-slow:
    console.log(text)
default:
    console.log("slow is not ready yet")
}
