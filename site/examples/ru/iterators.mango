// Итератор — это функция с параметром yield, как в Go 1.23; for проходит по нему
func fibonacci() func(yield func(number) bool) {
    return func(yield func(number) bool) {
        let a, b = 0, 1
        for {
            // false: цикл по нему остановился, значит, итератор тоже заканчивается
            if !yield(a) {
                return
            }
            a, b = b, a + b
        }
    }
}

for n in fibonacci() {
    if n > 50 {
        break
    }
    console.log(n)
}

// yield двух значений даёт ключ и значение
func numbered(words []string) func(yield func(number, string) bool) {
    return func(yield func(number, string) bool) {
        for i, word in words {
            if !yield(i + 1, word) {
                return
            }
        }
    }
}

for place, fruit in numbered(["манго", "папайя", "личи"]) {
    console.log(place, fruit)
}

// Он компилируется в генератор JS: вызванный, он даёт ленивый итератор JS
const evens = fibonacci()().filter(n => n % 2 == 0).take(5).toArray()
console.log("чётные:", evens.join(", "))
