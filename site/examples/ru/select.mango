// select ждёт первую из нескольких операций с каналами
func after(ms number) chan bool {
    const ch = chan[bool](1)
    setTimeout(async () => {
        ch <- true
    }, ms)
    return ch
}

async func search(query string, ms number, out chan string) {
    <-after(ms) // как будто по сети
    out <- `результаты для «${query}» за ${ms} мс`
}

// Место для одного ответа: поиск, которого никто не ждёт, всё равно сможет закончиться
const fast = chan[string](1)
const slow = chan[string](1)
go search("манго", 100, fast)
go search("папайя", 2000, slow)

// Побеждает первый ответ; тайм-аут прекращает ожидание
for let i = 0; i < 2; i++ {
    select {
    case text = <-fast:
        console.log(text)
    case text = <-slow:
        console.log(text)
    case <-after(500):
        console.log("тайм-аут: 500 мс")
    }
}

// default срабатывает, когда сразу ничего не готово
select {
case text = <-slow:
    console.log(text)
default:
    console.log("slow ещё не готов")
}
