interface Tab {
    title string
    content comp(name string)
}

comp Greeting(name string) {
    return <p>Привет, {name}!</p>
}

comp Farewell(name string) {
    mount() {
        console.log("Farewell показан")
        return () => console.log("Farewell удалён")
    }
    return <p>До свидания, {name}.</p>
}

// Компоненты в данных: тег берёт компонент из значения
const TABS []Tab = [
    { title: "Привет", content: Greeting },
    { title: "Пока", content: Farewell },
]

comp Tabs() {
    state name = "Аня"
    state Current comp(name string) = Greeting
    return <div>
        <input bind:value={name} />
        {for tab in TABS {
            <button onClick={Current = tab.content}>{tab.title}</button>
        }}
        <Current name={name} />
    </div>
}

document.body.append(<Tabs />)
