// @html-tag делает из компонента веб-компонент: <fruit-badge> работает в любом HTML,
// даже без MangoScript. Его разметка — в shadow root: стили страницы туда не проникают,
// кроме наследуемых вроде color и CSS-переменных вроде --accent-soft
const STYLE = `
    span { padding: 2px 10px; border-radius: 999px; background: var(--accent-soft) }
    .ripe { font-weight: bold }
`

@html-tag("fruit-badge")
comp FruitBadge(name string, count number = 1, ripe bool) {
    return <>
        <style>{STYLE}</style>
        <span class={ripe ? "ripe" : ""}>{name}: {count}</span>
    </>
}

// Из JS это такой же элемент, как любой другой. Атрибуты — текст: count="3" становится
// числом 3, а ripe равен true, потому что атрибут есть
const badge = document.createElement("fruit-badge")
badge.setAttribute("name", "Манго")
badge.setAttribute("count", "3")
badge.setAttribute("ripe", "")
document.body.append(badge)

// Разметка задаёт свойства как есть, и элемент следует за состоянием
comp Basket() {
    state kiwis = 1
    return <p>
        <fruit-badge name="Киви" count={kiwis} />
        {" "}<button onClick={kiwis++}>Ещё киви</button>
    </p>
}

document.body.append(<Basket />)
