// chan(stream) превращает ReadableStream в канал, а stream(ch) — канал в поток
interface Product {
    title string
    price number
}

// Горутина в другом потоке получает тело кусок за куском, по мере того как оно идёт по сети
async func parse(chunks <-chan string) ([]Product, number) {
    let text = ""
    let count = 0
    for chunk in chunks {
        text += chunk
        count++
    }
    return JSON.parse(text) as []Product, count
}

const response = await fetch("https://fakestoreapi.com/products")
const text = response.body?.pipeThrough(new TextDecoderStream())

// Тело читается вперёд не дальше четырёх кусков, на которые в канале есть место
const chunks, failed = chan(text, 4)
const products, count = await go parse(chunks)
console.log(`${products.length} товаров в ${count} кусках`)
console.log("ошибка:", <-failed)

// В обратную сторону: канал строк становится телом Response
const lines = chan<string>()
async func list() {
    for product in products.slice(0, 3) {
        lines <- `${product.title}: $${product.price}\n`
    }
    close(lines)
}
list()
const body = stream(lines).pipeThrough(new TextEncoderStream())
console.log(await new Response(body).text())
