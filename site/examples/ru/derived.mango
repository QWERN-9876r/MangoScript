// derived — значение, вычисленное из состояния: когда состояние меняется, оно вычисляется
// заново, до обновления разметки, которая его читает
comp Basket() {
    state prices []number = [120, 90]
    derived total = prices.reduce((sum, price) => sum + price, 0)
    derived note = total > 400 ? "Манго уже много" : "Можно взять ещё"

    // effect выполняется, когда разметка создана, и снова, когда меняется то, что он читает
    effect {
        console.log("итого:", total)
    }

    return <div>
        <button onClick={prices.push(120)}>Добавить манго</button>
        <p>Фруктов: {prices.length}, на {total} ₽. {note}</p>
    </div>
}

document.body.append(<Basket />)
