// style holds CSS for the component's own markup: its elements get a class of their own, so
// the rules do not leak to the rest of the page. {expr} in a value comes from code and follows it
comp Ripeness() {
    state percent = 30

    style {
        .ripeness {
            display: grid;
            gap: 8px;
            max-width: 260px;
        }
        .track {
            height: 10px;
            border-radius: 999px;
            background: #f0e3cb;
        }
        .fill {
            width: {percent}%;
            height: 100%;
            border-radius: inherit;
            background: {percent < 70 ? "#8fcf6f" : "#ffad42"};
            transition: width 0.3s;
        }
    }

    return <div class="ripeness">
        <div class="track"><div class="fill" /></div>
        <button onClick={percent = percent >= 100 ? 0 : percent + 35}>
            Ripen: {percent < 70 ? "green" : "ripe"}
        </button>
    </div>
}

document.body.append(<Ripeness />)
