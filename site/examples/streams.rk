// chan(stream) turns a ReadableStream into a channel, and stream(ch) a channel into a stream
interface Product {
    title string
    price number
}

// A goroutine in another thread gets the body chunk by chunk, as it comes over the network
async func parse(chunks <-chan string) ([]Product, number) {
    let text = ""
    let count = 0
    for chunk in chunks {
        text += chunk
        count++
    }
    return JSON.parse(text) as []Product, count
}

const response = await fetch("https://fakestoreapi.com/products")
const text = response.body?.pipeThrough(new TextDecoderStream())

// The body is read no further ahead than the 4 chunks the channel has room for
const chunks, failed = chan(text, 4)
const products, count = await go parse(chunks)
console.log(`${products.length} products in ${count} chunks`)
console.log("error:", <-failed)

// The other way: a channel of lines is the body of a Response
const lines = chan<string>()
async func list() {
    for product in products.slice(0, 3) {
        lines <- `${product.title}: $${product.price}\n`
    }
    close(lines)
}
list()
const body = stream(lines).pipeThrough(new TextEncoderStream())
console.log(await new Response(body).text())
