// Страница — один компонент TodoApp. Его состояние объявлено через state: после каждого изменения
// компилятор сам обновляет те узлы, которые от него зависят. Функции render() больше нет.

import { Todo, TodoList, parseTitle } from "./todos.mango"
import { load, save } from "./storage.mango"

const FILTERS = [
    { id: "all", label: "Все" },
    { id: "active", label: "Активные" },
    { id: "done", label: "Готовые" },
]

comp TodoApp() {
    const saved, loadError = load()
    state todos = new TodoList(saved)
    state title = ""
    state message = loadError?.message ?? ""
    state filter = "all"

    // Разметка ниже вызывает эти функции, поэтому зависит от того, что они читают.
    func summary() string {
        const left, done = todos.counts()
        return `Осталось: ${left} · готово: ${done}`
    }

    func hasDone() bool {
        const _, done = todos.counts()
        return done > 0
    }

    func add() {
        const text, err = parseTitle(title)
        if err != null {
            message = err.message
            return
        }
        todos.add(text)
        save(todos)
        title = ""
        message = ""
    }

    // Вызов метода todos (add, toggle, remove, clearDone) считается изменением списка. save его
    // только читает; когда появится effect, сохранение переедет туда.
    return <>
        <form id="new-todo" onSubmit={event.preventDefault(); add()}>
            <input id="title" bind:value={title} placeholder="Что сделать?" autocomplete="off" autofocus />
            <button>Добавить</button>
        </form>
        <p id="message" role="alert" hidden={message == ""}>{message}</p>

        <nav aria-label="Фильтр">
            {FILTERS.map(f => <button class={f.id == filter ? "active" : ""} onClick={filter = f.id}>{f.label}</button>)}
        </nav>

        <ul id="list">
            {todos.visible(filter).map(todo => <TodoItem
                todo={todo}
                onToggle={todos.toggle(todo.id); save(todos)}
                onRemove={todos.remove(todo.id); save(todos)}
            />)}
        </ul>

        <footer>
            <span id="summary">{summary()}</span>
            <button id="clear-done" disabled={!hasDone()} onClick={todos.clearDone(); save(todos)}>
                Убрать готовые
            </button>
        </footer>
    </>
}

comp TodoItem(todo Todo, onToggle func(), onRemove func()) {
    return <li class={todo.done ? "todo done" : "todo"}>
        <input type="checkbox" checked={todo.done} onChange={onToggle} />
        <span>{todo.title}</span>
        <button title="Удалить" onClick={onRemove}>×</button>
    </li>
}

document.querySelector("main").append(<TodoApp />)
