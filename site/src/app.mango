// Страница документации MangoScript. Она сама написана на MangoScript: разделы руководства — в
// guide.mango, примеры с вкладками «JavaScript» и «Запустить» — в example.mango, песочница — в
// playground.mango. Компилятор работает прямо в браузере.

import { SECTIONS } from "./guide.mango"
import { playground } from "./playground.mango"

interface Link {
    id string
    title string
}

const NAV []Link = [...SECTIONS, { id: "playground", title: "Песочница" }]

comp DocsPage() {
    state active = NAV[0].id

    // В меню выделен раздел, заголовок которого последним ушёл за верх экрана, а в самом низу
    // страницы — последний раздел.
    func updateActive() {
        let current = NAV[0].id
        for link in NAV {
            const element = document.getElementById(link.id)
            if element != null && element.getBoundingClientRect().top < 120 {
                current = link.id
            }
        }
        if window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2 {
            current = NAV[NAV.length - 1].id
        }
        active = current
    }

    window.addEventListener("scroll", updateActive, { passive: true })
    window.addEventListener("load", updateActive)

    return <>
        <header class="topbar">
            <a class="brand" href="#intro"><span aria-hidden="true">🥭</span> MangoScript</a>
            <span class="tagline">JavaScript с синтаксисом Go, типами и компонентами</span>
            <a class="topbar-link" href="#playground">Песочница</a>
        </header>
        <div class="layout">
            <nav class="sidebar" aria-label="Разделы">
                {for link in NAV {
                    <a href={`#${link.id}`} class={link.id == active ? "active" : ""}>{link.title}</a>
                }}
            </nav>
            <main class="content">
                {for section in SECTIONS {
                    <section id={section.id} class="doc-section">
                        <h2>{section.title}</h2>
                        {section.content()}
                    </section>
                }}
                <section id="playground" class="doc-section">
                    <h2>Песочница</h2>
                    <p>
                        Пишите код в редакторе — под ним сразу появится JavaScript, который из него
                        получился, или ошибки компиляции. Кнопка «В песочницу» в любом примере выше
                        открывает его здесь.
                    </p>
                    {playground()}
                </section>
                <footer class="footer">
                    Эта страница написана на MangoScript и собрана компилятором из этого
                    репозитория.
                </footer>
            </main>
        </div>
    </>
}

document.body.append(<DocsPage />)
