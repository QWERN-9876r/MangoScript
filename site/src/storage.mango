// Задачи хранятся в localStorage браузера.

import { Todo, TodoList } from "./todos.mango"

const KEY = "mango-todos"

export func load() ([]Todo, error) {
    const saved = localStorage.getItem(KEY)
    if saved == null {
        return [], null
    }
    // JSON.parse бросает исключение — превращаем его в ошибку-значение.
    try {
        return JSON.parse(saved), null
    } catch e {
        return [], error(`Не удалось прочитать сохранённые задачи: ${e.message}`)
    }
}

export func save(todos TodoList) {
    localStorage.setItem(KEY, JSON.stringify(todos.all()))
}
