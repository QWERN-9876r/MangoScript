// An example in the guide: its code, the JS generated from it and the result of running it. The
// code is in site/examples/<name>.mango (site/examples/ru for Russian), so tests check that every
// example compiles. It gets into the page at build time (virtual:examples in vite.config.ts), so
// the example has its full height when the page is first drawn.

import { Button } from "../ui/button.mango"
import { CopyButton } from "../ui/code-block.mango"
import { TabItem, Tabs } from "../ui/tabs.mango"
import styles from "./example.module.css"
import { exampleCode, text } from "./i18n.mango"
import { openInPlayground } from "./playground.mango"
import { codeView, compiledView, previewArea, resultView, runProgram } from "./sandbox.mango"

comp Example(name string) {
    const t = text()
    const code = exampleCode(name)
    // An example that imports modules cannot run on the page.
    const tabs []TabItem = [
        { id: "code", label: "MangoScript" },
        { id: "js", label: "JavaScript" },
        ...(code.includes("import ") ? [] : [{ id: "result", label: t.run }]),
    ]
    state tab = "code"
    state lines []string = []
    const preview = previewArea()

    func select(id string) {
        if id == "result" {
            runProgram(code, preview, output => {
                lines = output
            })
        }
        tab = id
    }

    return <figure class={styles.example}>
        <Tabs items={tabs} active={tab} onSelect={select(event)}>
            <CopyButton text={code} label={t.copy} doneLabel={t.copied} />
            <Button kind="ghost" size="sm" icon="external" onPress={openInPlayground(code)}>
                {t.openInPlayground}
            </Button>
        </Tabs>
        {switch tab {
        case "code":
            <div>{codeView(code)}</div>
        case "js":
            <div>{compiledView(code)}</div>
        default:
            <div>{resultView(preview, lines)}</div>
        }}
    </figure>
}

export func example(name string) Node {
    return <Example name={name} />
}
