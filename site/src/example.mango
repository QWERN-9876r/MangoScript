// An example in the guide: its code, the JS generated from it and the result of running it. The
// code is in site/examples/<name>.mango (site/examples/ru for Russian), so tests check that every
// example compiles. It gets into the page at build time (virtual:examples in vite.config.ts), so
// the example has its full height when the page is first drawn.

import { exampleCode, text } from "./i18n.mango"
import { highlight } from "./highlight.mango"
import { openInPlayground } from "./playground.mango"
import { compiledView, consoleView, runProgram } from "./sandbox.mango"

comp Example(name string) {
    const t = text()
    const code = exampleCode(name)
    state tab = "code"
    state lines []string = []
    const preview = <div class="preview" data-empty={t.emptyPreview} />

    func run() {
        runProgram(code, preview, output => {
            lines = output
        })
        tab = "result"
    }

    return <figure class="example">
        <div class="tabs">
            <button class={tab == "code" ? "tab active" : "tab"} onClick={tab = "code"}>MangoScript</button>
            <button class={tab == "js" ? "tab active" : "tab"} onClick={tab = "js"}>JavaScript</button>
            {if !code.includes("import ") {
                <button class={tab == "result" ? "tab active" : "tab"} onClick={run()}>{t.run}</button>
            }}
            <button class="tab open" onClick={openInPlayground(code)}>{t.openInPlayground}</button>
        </div>
        {switch tab {
        case "code":
            <pre class="code">{highlight(code, "mango")}</pre>
        case "js":
            <div class="output-body">{compiledView(code)}</div>
        default:
            <div class="output-body result">{preview}{consoleView(lines)}</div>
        }}
    </figure>
}

export func example(name string) Node {
    return <Example name={name} />
}
