// The first screen of the page: what Rook is, buttons to the guide, the playground and the
// repository, and two tabs of code: goroutines with what they print, and a component next to the
// JavaScript it compiles to.

import { Badge } from "../ui/badge.rk"
import { LinkButton } from "../ui/button.rk"
import { Icon } from "../ui/icon.rk"
import { TabItem, Tabs } from "../ui/tabs.rk"
import styles from "./hero.module.css"
import { highlight } from "./highlight.rk"
import { REPOSITORY, text } from "./i18n.rk"

const GOROUTINES = `func isPrime(n number) bool {
    for let d = 2; d * d <= n; d++ {
        if n % d == 0 {
            return false
        }
    }
    return n > 1
}

const primes = make([]uint8, 10_000_000)

let started = Date.now()
for i, _ in primes {
    primes[i] = isPrime(i) ? 1 : 0
}
console.log(\`one thread: \${Date.now() - started} ms\`)

started = Date.now()
go for i, _ in primes {
    primes[i] = isPrime(i) ? 1 : 0
}
console.log(\`go for:     \${Date.now() - started} ms\`)`

// What GOROUTINES printed under Node on a machine with 14 processors: `go for` splits the array
// among them.
const OUTPUT = `one thread: 1736 ms
go for:     377 ms`

const COMPONENT = `comp Counter() {
    state count = 0
    return <button onClick={count++}>
        Clicked {count} times
    </button>
}`

const JS = `let count = 0;
const $$button = document.createElement("button");
$$button.addEventListener("click", () => {
  count++;
  $$text.data = count;
});
const $$text = document.createTextNode(count);
$$button.append("Clicked ", $$text, " times");`

// Both tabs stay on the page, one over the other, so the block is as tall as the taller one and
// the page does not jump; the hidden one fades out while the selected one comes in.
comp Panels(shown bool, label string, code Node, resultLabel string, result Node) {
    return <div class={shown ? styles.panels : `${styles.panels} ${styles.hidden}`}>
        <figure class={styles.panel}>
            <figcaption class={styles.label}>{label}</figcaption>
            <pre class={styles.code}>{code}</pre>
        </figure>
        <span class={styles.arrow}><Icon name="arrow-right" size={16} /></span>
        <figure class={styles.panel}>
            <figcaption class={styles.label}>{resultLabel}</figcaption>
            <pre class={styles.code}>{result}</pre>
        </figure>
    </div>
}

export comp Hero() {
    const t = text()
    const tabs []TabItem = [
        { id: "goroutines", label: t.heroGoroutines },
        { id: "components", label: t.heroComponents },
    ]
    state tab = "goroutines"
    return <section class={styles.hero}>
        <div class={styles.inner}>
            <div>
                <Badge>{t.heroBadge}</Badge>
                <h1 class={styles.title}>
                    Rook
                </h1>
                <p class={styles.tagline}>{t.tagline}</p>
                <p class={styles.lead}>{t.heroLead}</p>
                <div class={styles.actions}>
                    <LinkButton kind="primary" size="lg" href="#intro" icon="arrow-right">
                        {t.heroStart}
                    </LinkButton>
                    <LinkButton size="lg" href="#playground" icon="play">{t.playground}</LinkButton>
                    <LinkButton kind="ghost" size="lg" href={REPOSITORY} icon="github">GitHub</LinkButton>
                </div>
            </div>
            <div class={styles.demo}>
                <div class={styles.switch}>
                    <Tabs items={tabs} active={tab} onSelect={tab = event} />
                </div>
                <div class={styles.stack}>
                    <Panels
                        shown={tab == "goroutines"}
                        label="Rook"
                        code={highlight(GOROUTINES, "rook")}
                        resultLabel={t.terminal}
                        result={new Text(OUTPUT)}
                    />
                    <Panels
                        shown={tab == "components"}
                        label="Rook"
                        code={highlight(COMPONENT, "rook")}
                        resultLabel="JavaScript"
                        result={highlight(JS, "js")}
                    />
                </div>
            </div>
        </div>
    </section>
}
