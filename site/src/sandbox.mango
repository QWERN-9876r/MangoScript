// Compiling and running code right on the page. The compiler is the same as in mango build: Vite
// builds it for the browser from src/browser.ts. It does not check imports: there are no modules
// on disk here.

import { loadCompiler } from "./compiler.ts"
import { highlight } from "./highlight.mango"
import { text } from "./i18n.mango"

export interface Compiled {
    code string
    errors []string
}

type Compile func(string) Compiled

// The compiler is loaded on the first run, when a JavaScript tab is opened and when the playground
// comes into view; null until then. Compilations asked for while it loads wait in `waiting`.
let compiler ?Compile = null
let waiting []func(?Compile) = []

/** Compiles `source` once the compiler is loaded: right away if it already is. */
export func compileMango(source string, done func(Compiled)) {
    withCompiler(compile => {
        if compile == null {
            done({ code: "", errors: [text().compilerFailed] })
        } else {
            done(compile(source))
        }
    })
}

/** Calls `use` with the compiler, or with null if it could not be loaded. */
func withCompiler(use func(?Compile)) {
    if compiler != null {
        use(compiler)
        return
    }
    waiting.push(use)
    if waiting.length > 1 {
        return
    }
    loadCompiler().then(
        module => {
            compiler = source => {
                const result = module.compile(source)
                return {
                    code: result.code,
                    errors: result.diagnostics.map(d => `${text().position(d.line, d.column)}: ${d.message}`),
                }
            }
            resolveWaiting(compiler)
        },
        // Without the compiler the waiting ones get an error, and the next compilation tries again.
        () => resolveWaiting(null),
    )
}

func resolveWaiting(compile ?Compile) {
    const callbacks = waiting
    waiting = []
    for use in callbacks {
        use(compile)
    }
}

interface Owner {
    removed bool
    cleanups []func()
}

// The program runs as the owner of its components, with the same key as {if} and {for} in
// compiled code (owner in src/codegen/helpers.ts). Before the next run, what the mount() of the
// previous one returned runs, so its timers stop.
const OWNER = Symbol.for("mangoscript.owner")
let owners Map[HTMLElement, Owner] = new Map()

func runOwned(preview HTMLElement, run func()) {
    const previous = owners.get(preview)
    if previous != null {
        previous.removed = true
        for let i = previous.cleanups.length - 1; i >= 0; i-- {
            previous.cleanups[i]()
        }
    }
    const owner Owner = { removed: false, cleanups: [] }
    owners.set(preview, owner)
    const global any = globalThis
    const parent = global[OWNER]
    global[OWNER] = owner
    defer {
        global[OWNER] = parent
    }
    run()
}

// The number of the last run in each result area: output of earlier runs is dropped.
let runs Map[HTMLElement, number] = new Map()

// A custom element cannot be defined twice, so each run has its own tags: <app-card> of the
// program is <app-card-3> on the page.
let allRuns = 0

/**
 * Runs a program: document.body is `preview`, and the lines of console.log go to `output` right
 * after the run and then with every new line. Compile errors and exceptions are lines too.
 */
export func runProgram(source string, preview HTMLElement, output func([]string)) {
    compileMango(source, compiled => {
        if compiled.errors.length > 0 {
            output(compiled.errors)
        } else if source.includes("import ") {
            output([text().noImports])
        } else {
            runCompiled(compiled.code, preview, output)
        }
    })
}

func runCompiled(code string, preview HTMLElement, output func([]string)) {
    const run = (runs.get(preview) ?? 0) + 1
    runs.set(preview, run)
    const lines []string = []
    // Output after the run, from mount() and timers, is shown right away, line by line.
    let finished = false
    // The language has no ...rest parameters yet, so extra arguments of console.log are dropped.
    const print = func(a any, b any, c any, d any, e any, f any) {
        if runs.get(preview) != run {
            return
        }
        const values []any = [a, b, c, d, e, f]
        let count = values.length
        for count > 0 && typeof values[count - 1] == "undefined" {
            count--
        }
        lines.push(values.slice(0, count).map(show).join(" "))
        if finished {
            output(lines.slice())
        }
    }
    const sandboxConsole = { log: print, info: print, warn: print, error: print }
    allRuns++
    const suffix = `-${allRuns}`
    const pageTag = (tag string) => tag.includes("-") ? tag + suffix : tag
    const sandboxElements = {
        define: (tag string, element any) => customElements.define(pageTag(tag), element),
        get: (tag string) => customElements.get(pageTag(tag)),
    }
    const sandboxDocument = {
        body: preview,
        createElement: (tag string) => document.createElement(pageTag(tag)),
        createTextNode: (text string) => document.createTextNode(text),
        createDocumentFragment: () => document.createDocumentFragment(),
        querySelector: (selector string) => preview.querySelector(selector),
    }

    preview.replaceChildren()
    try {
        const program = globalThis.Function("console", "document", "customElements", code)
        runOwned(preview, () => program(sandboxConsole, sandboxDocument, sandboxElements))
    } catch e {
        lines.push(`${text().exception}: ${e.message}`)
    }
    finished = true
    output(lines.slice())
}

func show(value any) string {
    if typeof value == "string" {
        return value
    }
    if value != null && typeof value == "object" && typeof value.nodeName == "string" {
        return `<${value.nodeName.toLowerCase()}>`
    }
    return JSON.stringify(value)
}

/**
 * The generated JS, highlighted, or the compile errors. While the compiler loads, the view shows a
 * note; once it is loaded, the view is filled before it is returned.
 */
export func compiledView(source string) Node {
    const view = <div>{loadingView()}</div>
    compileMango(source, compiled => view.replaceChildren(compiledNode(compiled)))
    return view
}

/** What a tab shows until the compiler is loaded. */
export func loadingView() Node {
    return <p class="compiler-loading">{text().loadingCompiler}</p>
}

func compiledNode(compiled Compiled) Node {
    if compiled.errors.length > 0 {
        return <ul class="errors">
            {for message in compiled.errors {
                <li>{message}</li>
            }}
        </ul>
    }
    return <pre class="code">{highlight(compiled.code, "js")}</pre>
}

/** What the program printed to the console. */
export func consoleView(lines []string) Node {
    if lines.length == 0 {
        return <p class="console-empty">{text().emptyConsole}</p>
    }
    return <pre class="console">{lines.join("\n")}</pre>
}
