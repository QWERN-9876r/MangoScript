// Compiling and running code right on the page. The compiler is the same as in mango build: Vite
// builds it for the browser from src/browser.ts. It does not check imports: there are no modules
// on disk here.

import { compile } from "../../src/browser.ts"
import { highlight } from "./highlight.mango"
import { text } from "./i18n.mango"

export interface Compiled {
    code string
    errors []string
}

export func compileMango(source string) Compiled {
    const result = compile(source)
    return {
        code: result.code,
        errors: result.diagnostics.map(d => `${text().position(d.line, d.column)}: ${d.message}`),
    }
}

interface Owner {
    removed bool
    cleanups []func()
}

// The program runs as the owner of its components, with the same key as {if} and {for} in
// compiled code (owner in src/codegen/helpers.ts). Before the next run, what the mount() of the
// previous one returned runs, so its timers stop.
const OWNER = Symbol.for("mangoscript.owner")
let owners Map[HTMLElement, Owner] = new Map()

func runOwned(preview HTMLElement, run func()) {
    const previous = owners.get(preview)
    if previous != null {
        previous.removed = true
        for let i = previous.cleanups.length - 1; i >= 0; i-- {
            previous.cleanups[i]()
        }
    }
    const owner Owner = { removed: false, cleanups: [] }
    owners.set(preview, owner)
    const global any = globalThis
    const parent = global[OWNER]
    global[OWNER] = owner
    defer {
        global[OWNER] = parent
    }
    run()
}

// The number of the last run in each result area: output of earlier runs is dropped.
let runs Map[HTMLElement, number] = new Map()

/**
 * Runs a program: document.body is `preview`, and the lines of console.log go to `output` right
 * after the run and then with every new line. Compile errors and exceptions are lines too.
 */
export func runProgram(source string, preview HTMLElement, output func([]string)) {
    const compiled = compileMango(source)
    if compiled.errors.length > 0 {
        output(compiled.errors)
        return
    }
    if source.includes("import ") {
        output([text().noImports])
        return
    }

    const run = (runs.get(preview) ?? 0) + 1
    runs.set(preview, run)
    const lines []string = []
    // Output after the run, from mount() and timers, is shown right away, line by line.
    let finished = false
    // The language has no ...rest parameters yet, so extra arguments of console.log are dropped.
    const print = func(a any, b any, c any, d any, e any, f any) {
        if runs.get(preview) != run {
            return
        }
        const values []any = [a, b, c, d, e, f]
        let count = values.length
        for count > 0 && typeof values[count - 1] == "undefined" {
            count--
        }
        lines.push(values.slice(0, count).map(show).join(" "))
        if finished {
            output(lines.slice())
        }
    }
    const sandboxConsole = { log: print, info: print, warn: print, error: print }
    const sandboxDocument = {
        body: preview,
        createElement: (tag string) => document.createElement(tag),
        createTextNode: (text string) => document.createTextNode(text),
        createDocumentFragment: () => document.createDocumentFragment(),
        querySelector: (selector string) => preview.querySelector(selector),
    }

    preview.replaceChildren()
    try {
        const program = globalThis.Function("console", "document", compiled.code)
        runOwned(preview, () => program(sandboxConsole, sandboxDocument))
    } catch e {
        lines.push(`${text().exception}: ${e.message}`)
    }
    finished = true
    output(lines.slice())
}

func show(value any) string {
    if typeof value == "string" {
        return value
    }
    if value != null && typeof value == "object" && typeof value.nodeName == "string" {
        return `<${value.nodeName.toLowerCase()}>`
    }
    return JSON.stringify(value)
}

/** The generated JS, highlighted, or the compile errors. */
export func compiledView(source string) Node {
    const compiled = compileMango(source)
    if compiled.errors.length > 0 {
        return <ul class="errors">
            {for message in compiled.errors {
                <li>{message}</li>
            }}
        </ul>
    }
    return <pre class="code">{highlight(compiled.code, "js")}</pre>
}

/** What the program printed to the console. */
export func consoleView(lines []string) Node {
    if lines.length == 0 {
        return <p class="console-empty">{text().emptyConsole}</p>
    }
    return <pre class="console">{lines.join("\n")}</pre>
}
