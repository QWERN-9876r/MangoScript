// Разделы русского гайда о горутинах, каналах и select; все разделы перечислены в guide.mango.

import { example } from "../example.mango"

export comp Async() {
    return <>
        <p>
            <code>async func</code> возвращает Promise, а <code>await</code> его ждёт. Типы
            результатов пишутся как у любой функции, в том числе несколько:
            {" "}<code>async func load() (string, error)</code> возвращает
            {" "}<code>{"Promise<(string, error)>"}</code>, а <code>await</code> распаковывает значения
            обратно. Модуль может делать <code>await</code> на верхнем уровне, а обработчик события
            может быть async: изменение состояния после <code>await</code> обновляет разметку.
        </p>
        {example("async")}
    </>
}

export comp Goroutines() {
    return <>
        <p>
            JavaScript выполняет программу в одном потоке: долгое вычисление останавливает всё
            остальное, а воркеру нужны отдельный файл и сообщения, написанные вручную. В MangoScript
            это одно слово, как в Go, а компилятор проверяет, что уходит в другой поток.
        </p>
        <p>
            <code>go f(x)</code> вызывает функцию горутиной, в другом потоке, и даёт Promise с
            результатом. Горутины идут одновременно на разных процессорах: потоки — это пул воркеров,
            Web Worker в браузере и worker thread в Node, не больше одного на процессор. Память у
            горутины с программой не общая: она получает копии аргументов и отправляет обратно
            копию результата, поэтому это данные, а функция не может пользоваться
            {" "}<code>let</code>-переменными модуля. Компилятор проверяет и то, и другое.
        </p>
        {example("goroutines")}
        <p>
            <code>{"go func(n number) { ... }(i)"}</code> выполняет функциональный литерал
            горутиной: локальные имена, которыми он пользуется, копируются в неё, как его
            аргументы. <code>transfer(x)</code> переносит <code>ArrayBuffer</code> или
            типизированный массив в горутину, а не копирует, и здесь он остаётся пустым.
            {" "}<code>go</code> нужен для работы, которая занимает процессор; чтобы ждать таймер
            или сеть, вызовите async-функцию без <code>await</code>: она сразу работает в том же
            потоке.
        </p>
        {example("go-func")}
        <p>
            <code>{"go for i, v in items { ... }"}</code> — параллельный цикл: массив делится на
            части, по одной на процессор, каждая часть выполняется горутиной, а цикл ждёт их все.
            Воркер получает только свою часть, поэтому тело пишет только свой элемент,
            {" "}<code>items[i]</code>, а другие элементы читает из другого массива; остальные
            имена, которыми оно пользуется, копируются в него, как в функциональный литерал.
        </p>
        {example("go-for")}
    </>
}

export comp Channels() {
    return <>
        <p>
            Каналы передают значения между горутинами, как в Go: <code>{"chan<number>(10)"}</code>
            создаёт канал с местом на десять чисел, <code>{"ch <- v"}</code> отправляет значение и
            ждёт, пока канал его примет, <code>{"<-ch"}</code> получает значение, а
            {" "}<code>for v in ch</code> получает их до <code>close(ch)</code>. Обе стороны ждут,
            поэтому работают в async-функциях. Канал можно передать горутинам в других потоках:
            то, что через него проходит, копируется. <code>{"<-chan number"}</code> только
            получает, а <code>{"chan<- string"}</code> только отправляет: функция, которая их
            принимает, не может пользоваться ими иначе.
        </p>
        {example("channels")}
    </>
}

export comp Select() {
    return <>
        <p>
            <code>select</code> ждёт первую из нескольких операций с каналами и запускает её ветку,
            как в Go: <code>{"case text = <-fast:"}</code> получает значение в новую переменную
            ветки, <code>{"case out <- v:"}</code> отправляет, а <code>default</code> срабатывает,
            когда сразу ничего не готово. <code>after(ms)</code> — канал, в который один раз
            приходит время через <code>ms</code>, поэтому он даёт тайм-аут, а ветка, чей канал
            равен <code>null</code>, никогда не выполняется.
        </p>
        {example("select")}
        <p>
            <code>tick(ms)</code> присылает время каждые <code>ms</code>, пока не вызван
            {" "}<code>close(ticks)</code>. <code>cancel(task)</code> останавливает горутину по
            Promise из <code>go</code>: она останавливается сразу, даже посреди цикла, а
            Promise завершается ошибкой «goroutine cancelled».
        </p>
        {example("timers")}
    </>
}
