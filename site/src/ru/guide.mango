// The Russian guide; the English one, en/guide.mango, has the same sections. Each section is a
// function that returns its markup; the examples are files in site/examples/ru.

import { example } from "../example.mango"
import { REPOSITORY, Section } from "../i18n.mango"
import { components, decorators, markup, mounting, reactivity, webComponents } from "./guide-components.mango"

export const SECTIONS []Section = [
    { id: "intro", title: "Что такое MangoScript", content: intro },
    { id: "variables", title: "Переменные и типы", content: variables },
    { id: "null", title: "null, union и сужение", content: nullSafety },
    { id: "functions", title: "Функции", content: functions },
    { id: "errors", title: "Ошибки и defer", content: errors },
    { id: "control", title: "Условия и циклы", content: control },
    { id: "classes", title: "Классы и интерфейсы", content: classes },
    { id: "generics", title: "Дженерики", content: generics },
    { id: "modules", title: "Модули", content: modules },
    { id: "markup", title: "Разметка", content: markup },
    { id: "components", title: "Компоненты", content: components },
    { id: "state", title: "Состояние", content: reactivity },
    { id: "mount", title: "Монтирование", content: mounting },
    { id: "web-components", title: "Веб-компоненты", content: webComponents },
    { id: "decorators", title: "Декораторы", content: decorators },
    { id: "tools", title: "Инструменты", content: tools },
]

func intro() Node {
    return <>
        <p class="lead">
            MangoScript — язык с семантикой JavaScript, синтаксисом в духе Go и статической
            типизацией. Он компилируется в читаемый JavaScript без рантайма: что написано, то и
            выполняется.
        </p>
        <ul>
            <li>
                <b>Как в JavaScript:</b> те же значения, объекты, массивы, классы и модули. Можно
                использовать любые JS-библиотеки.
            </li>
            <li>
                <b>Как в Go:</b> <code>func</code>, тип после имени, несколько результатов, ошибки
                вторым значением, <code>defer</code> и один цикл <code>for</code>.
            </li>
            <li>
                <b>Типы:</b> компилятор проверяет программу до запуска, включая <code>null</code>:
                значение типа <code>?User</code> нельзя использовать без проверки.
            </li>
            <li>
                <b>Разметка и компоненты:</b> <code>&lt;button&gt;</code> в коде создаёт настоящий
                DOM-элемент, а компонент с <code>state</code> сам обновляет свою разметку.
            </li>
        </ul>
        <p>
            У каждого примера есть вкладка <b>JavaScript</b> — это код, который генерирует
            компилятор, запущенный прямо на этой странице. <b>Запустить</b> выполняет пример,
            а <b>В песочницу</b> открывает его в редакторе внизу страницы.
        </p>
        {example("hello")}
    </>
}

func variables() Node {
    return <>
        <p>
            Переменные объявляются как в JavaScript — через <code>let</code> и <code>const</code>,
            а тип пишется после имени, как в Go. Если есть значение, тип можно не писать:
            компилятор выведет его сам.
        </p>
        <p>
            У <code>let</code> без значения — нулевое значение типа, как в Go: <code>0</code>,
            {" "}<code>""</code>, <code>false</code>, пустой массив или <code>null</code>.
        </p>
        {example("variables")}
        <table>
            <thead>
                <tr><th>Тип</th><th>Что это</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>number</code>, <code>string</code>, <code>bool</code></td>
                    <td>числа, строки и логические значения</td>
                </tr>
                <tr><td><code>[]T</code></td><td>массив значений типа <code>T</code></td></tr>
                <tr><td><code>?T</code></td><td><code>T</code> или <code>null</code></td></tr>
                <tr>
                    <td><code>func(number) string</code></td>
                    <td>функция с параметром <code>number</code> и результатом <code>string</code></td>
                </tr>
                <tr>
                    <td><code>interface User {"{ ... }"}</code></td>
                    <td>объект с перечисленными полями и методами</td>
                </tr>
                <tr><td><code>type ID number</code></td><td>другое имя для типа</td></tr>
                <tr><td><code>any</code></td><td>что угодно, без проверок — например, значения из JS</td></tr>
            </tbody>
        </table>
        {example("types")}
    </>
}

func nullSafety() Node {
    return <>
        <p>
            Значение типа <code>?T</code> может быть <code>null</code>, а значение типа
            {" "}<code>T</code> — нет. Обратиться к полям <code>?T</code> без проверки нельзя:
            ошибка будет при компиляции, а не в браузере у пользователя.
        </p>
        <p>
            После проверки <code>if todo != null</code> тип сужается до <code>Todo</code>. С
            {" "}<code>?T</code> работают и привычные <code>?.</code> и <code>??</code>.
        </p>
        {example("null-safety")}
        <p>
            Тип может быть объединением нескольких: <code>string | number</code>. Литеральный тип
            {" "}<code>"all"</code> допускает только это значение, поэтому
            {" "}<code>{'type Filter "all" | "active" | "done"'}</code> ловит опечатки в строках.
            Union сужают так же, как <code>?T</code>: через <code>typeof</code>,
            {" "}<code>instanceof</code>, сравнение с литералом и <code>switch</code>.
        </p>
        {example("unions")}
    </>
}

func functions() Node {
    return <>
        <p>
            Функция объявляется через <code>func</code>. Параметры одного типа можно перечислить
            через запятую, а результатов может быть несколько — их распаковывают в несколько
            переменных.
        </p>
        <p>
            Литералы <code>{"func(x number) number { ... }"}</code> и стрелочные функции
            {" "}<code>x =&gt; x * 2</code> компилируются в стрелочные функции JS, поэтому
            {" "}<code>this</code> в них — тот же, что снаружи. Такая функция в инициализаторе
            переменной выполняется после него и поэтому может использовать переменную: это может
            быть рекурсивный литерал или колбэк, который останавливает свой таймер. Если тип
            функции зависит от её тела, как в <code>{"const f = () => f()"}</code>, тип переменной
            нужно написать.
        </p>
        {example("functions")}
    </>
}

func errors() Node {
    return <>
        <p>
            Для обычных ошибок исключения не нужны: функция возвращает ошибку вторым значением, а
            вызывающий код её проверяет. Ошибка создаётся функцией <code>error("...")</code>.
        </p>
        {example("errors")}
        <p>
            Исключения из JS-кода ловят через <code>try</code> / <code>catch</code>.
            {" "}<code>defer</code> откладывает вызов до выхода из функции — удобно для очистки
            ресурсов: вызов выполнится и после <code>return</code>, и после исключения.
        </p>
        {example("defer")}
    </>
}

func control() Node {
    return <>
        <p>
            Условия и циклы — как в Go: без скобок вокруг условия и всегда с фигурными скобками.
            Цикл один — <code>for</code>: перебор массива, цикл с условием и классический цикл с
            тремя частями. В <code>switch</code> нет <code>break</code>: каждая ветка заканчивается
            сама.
        </p>
        {example("control")}
    </>
}

func classes() Node {
    return <>
        <p>
            Классы — как в TypeScript: поля с типами, <code>constructor</code>,
            {" "}<code>extends</code>, модификаторы <code>private</code> и <code>protected</code>.
        </p>
        <p>
            Интерфейсы структурные: класс или объект подходит, если у него есть нужные поля и
            методы. <code>implements</code> только просит компилятор проверить это в объявлении
            класса.
        </p>
        {example("classes")}
    </>
}

func generics() Node {
    return <>
        <p>
            Параметры типа пишутся в квадратных скобках, как в Go:
            {" "}<code>{"func last[T any](xs []T) ?T"}</code>, <code>{"interface Box[T]"}</code>,
            {" "}<code>{"class Stack[T]"}</code>. В типах аргументы тоже в квадратных скобках:
            {" "}<code>Box[number]</code>, <code>Stack[string]</code>.
        </p>
        <p>
            При вызове аргументы типа не пишутся: компилятор выводит их из аргументов или из
            ожидаемого типа. Ограничение <code>[T Named]</code> разрешает только подходящие типы
            и даёт значениям <code>T</code> члены <code>Named</code>. В JS типы стираются.
        </p>
        {example("generics")}
    </>
}

func modules() Node {
    return <>
        <p>
            Модули — это ES-модули: <code>import</code> и <code>export</code> как в JS. Импорт
            {" "}<code>.mango</code>-модуля проверяется: компилятор читает его экспорты и знает их
            типы.
        </p>
        <p>
            Типы npm-пакетов, <code>.ts</code>-файлов и модулей Node (<code>node:fs</code>) берутся
            из объявлений TypeScript: <code>readFileSync(path, "utf8")</code> — это
            {" "}<code>string</code>, а <code>request.url</code> у <code>IncomingMessage</code> —
            {" "}<code>?string</code>. Модуль без объявлений имеет тип <code>any</code>. Песочница
            работает без компилятора TypeScript, поэтому здесь такие импорты — <code>any</code>.
        </p>
        <p>
            <code>mango build</code> компилирует файл вместе со всеми <code>.mango</code>-модулями,
            которые он импортирует, и заменяет в путях <code>.mango</code> на <code>.js</code>.
            Рядом с каждым <code>.js</code> он пишет <code>.d.ts</code>, так что модуль можно
            импортировать из TypeScript с типами.
            Песочница на этой странице модулей не загружает, поэтому пример ниже не запускается.
        </p>
        {example("modules")}
    </>
}

const COMMANDS = `npm install --save-dev mangoscript
npx mango build app.mango            # app.js рядом с исходником
npx mango build src --out-dir dist   # все модули папки
npx mango run app.mango              # скомпилировать и запустить`

const REPOSITORY_COMMANDS = `npm run site:dev         # этот сайт на сервере разработки Vite
npm run vscode:install   # подсветка синтаксиса в VS Code`

func tools() Node {
    return <>
        <p>
            Компилятор — npm-пакет <code>mangoscript</code>, он работает в Node.js 24:
        </p>
        <pre class="code">{COMMANDS}</pre>
        <p>
            Для проектов на Vite есть плагин <code>mangoscript/vite</code>: с ним
            {" "}<code>.mango</code>-модули импортируются как обычные, а ошибки типов показываются
            поверх страницы. Этот сайт собран именно так.
        </p>
        <p>
            Компилятор написан на TypeScript, исходный код — в
            {" "}<a href={REPOSITORY}>репозитории на GitHub</a>. Спецификация языка с обоснованиями
            решений — в <code>docs/spec.ru.md</code>, концепция компонентов — в
            {" "}<code>docs/components.ru.md</code>. Эта страница тоже написана на MangoScript: её
            код — в <code>site/src</code>, а сервер — <code>site/server.mango</code>. Из корня
            репозитория:
        </p>
        <pre class="code">{REPOSITORY_COMMANDS}</pre>
    </>
}
