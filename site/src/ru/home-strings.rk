import { HomeStrings } from "../i18n.rk"

/** «раз» or «раза» after a number: 1 раз, 2 раза, 5 раз, 22 раза. */
func times(count number) string {
    const last = count % 10
    const teen = count % 100 >= 12 && count % 100 <= 14
    return last >= 2 && last <= 4 && !teen ? "раза" : "раз"
}

