// The English guide; the Russian one, ru/guide.mango, has the same sections. Each section is a
// function that returns its markup; the examples are files in site/examples.

import { example } from "../example.mango"
import { REPOSITORY, Section } from "../i18n.mango"

export const SECTIONS []Section = [
    { id: "intro", title: "What is MangoScript", content: intro },
    { id: "variables", title: "Variables and types", content: variables },
    { id: "null", title: "null, unions and narrowing", content: nullSafety },
    { id: "functions", title: "Functions", content: functions },
    { id: "errors", title: "Errors and defer", content: errors },
    { id: "control", title: "Conditions and loops", content: control },
    { id: "classes", title: "Classes and interfaces", content: classes },
    { id: "generics", title: "Generics", content: generics },
    { id: "modules", title: "Modules", content: modules },
    { id: "markup", title: "Markup", content: markup },
    { id: "components", title: "Components", content: components },
    { id: "state", title: "State", content: reactivity },
    { id: "mount", title: "Mounting", content: mounting },
    { id: "tools", title: "Tools", content: tools },
]

func intro() Node {
    return <>
        <p class="lead">
            MangoScript is a language with the semantics of JavaScript, Go-style syntax and static
            types. It compiles to readable JavaScript without a runtime: what you write is what
            runs.
        </p>
        <ul>
            <li>
                <b>Like JavaScript:</b> the same values, objects, arrays, classes and modules. Any
                JS library can be used.
            </li>
            <li>
                <b>Like Go:</b> <code>func</code>, the type after the name, several results, errors
                as a second value, <code>defer</code> and a single <code>for</code> loop.
            </li>
            <li>
                <b>Types:</b> the compiler checks the program before it runs, <code>null</code>
                included: a value of type <code>?User</code> cannot be used without a check.
            </li>
            <li>
                <b>Markup and components:</b> <code>&lt;button&gt;</code> in code creates a real DOM
                element, and a component with <code>state</code> updates its markup by itself.
            </li>
        </ul>
        <p>
            Every example has a <b>JavaScript</b> tab with the code generated by the compiler, which
            runs right on this page. <b>Run</b> runs the example, and <b>Open in playground</b>
            opens it in the editor at the bottom of the page.
        </p>
        {example("hello")}
    </>
}

func variables() Node {
    return <>
        <p>
            Variables are declared as in JavaScript, with <code>let</code> and <code>const</code>,
            and the type goes after the name, as in Go. With a value, the type can be left out: the
            compiler infers it.
        </p>
        <p>
            A <code>let</code> without a value gets the zero value of its type, as in Go:
            {" "}<code>0</code>, <code>""</code>, <code>false</code>, an empty array or
            {" "}<code>null</code>.
        </p>
        {example("variables")}
        <table>
            <thead>
                <tr><th>Type</th><th>What it is</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>number</code>, <code>string</code>, <code>bool</code></td>
                    <td>numbers, strings and booleans</td>
                </tr>
                <tr><td><code>[]T</code></td><td>an array of values of type <code>T</code></td></tr>
                <tr><td><code>?T</code></td><td><code>T</code> or <code>null</code></td></tr>
                <tr>
                    <td><code>func(number) string</code></td>
                    <td>a function with a <code>number</code> parameter and a <code>string</code> result</td>
                </tr>
                <tr>
                    <td><code>interface User {"{ ... }"}</code></td>
                    <td>an object with the listed fields and methods</td>
                </tr>
                <tr><td><code>type ID number</code></td><td>another name for a type</td></tr>
                <tr><td><code>any</code></td><td>anything, unchecked: for example, values from JS</td></tr>
            </tbody>
        </table>
        {example("types")}
    </>
}

func nullSafety() Node {
    return <>
        <p>
            A value of type <code>?T</code> may be <code>null</code>, and a value of type
            {" "}<code>T</code> may not. The fields of a <code>?T</code> cannot be used without a
            check: the error comes at compile time, not in the user's browser.
        </p>
        <p>
            After <code>if todo != null</code> the type narrows to <code>Todo</code>. The familiar
            {" "}<code>?.</code> and <code>??</code> work with <code>?T</code> too.
        </p>
        {example("null-safety")}
        <p>
            A type can be a union of several: <code>string | number</code>. The literal type
            {" "}<code>"all"</code> allows only that value, so
            {" "}<code>{'type Filter "all" | "active" | "done"'}</code> catches typos in strings.
            Unions narrow like <code>?T</code>: with <code>typeof</code>, <code>instanceof</code>, a
            comparison with a literal and <code>switch</code>.
        </p>
        {example("unions")}
    </>
}

func functions() Node {
    return <>
        <p>
            A function is declared with <code>func</code>. Parameters of the same type can be listed
            together, and a function can have several results, unpacked into several variables.
        </p>
        <p>
            Literals <code>{"func(x number) number { ... }"}</code> and arrow functions
            {" "}<code>x =&gt; x * 2</code> compile to JS arrow functions, so <code>this</code> in
            them is the one outside.
        </p>
        {example("functions")}
    </>
}

func errors() Node {
    return <>
        <p>
            Ordinary errors need no exceptions: a function returns an error as its second value, and
            the caller checks it. An error is made with <code>error("...")</code>.
        </p>
        {example("errors")}
        <p>
            Exceptions from JS code are caught with <code>try</code> / <code>catch</code>.
            {" "}<code>defer</code> postpones a call until the function exits, which is handy for
            cleaning up: the call runs after a <code>return</code> and after an exception alike.
        </p>
        {example("defer")}
    </>
}

func control() Node {
    return <>
        <p>
            Conditions and loops are as in Go: no parentheses around the condition and always braces.
            There is one loop, <code>for</code>: over an array, with a condition, and the classic one
            with three parts. <code>switch</code> has no <code>break</code>: each case ends by itself.
        </p>
        {example("control")}
    </>
}

func classes() Node {
    return <>
        <p>
            Classes are as in TypeScript: typed fields, <code>constructor</code>,
            {" "}<code>extends</code>, the <code>private</code> and <code>protected</code> modifiers.
        </p>
        <p>
            Interfaces are structural: a class or an object fits if it has the fields and methods.
            {" "}<code>implements</code> only asks the compiler to check that where the class is
            declared.
        </p>
        {example("classes")}
    </>
}

func generics() Node {
    return <>
        <p>
            Type parameters go in square brackets, as in Go:
            {" "}<code>{"func last[T any](xs []T) ?T"}</code>, <code>{"interface Box[T]"}</code>,
            {" "}<code>{"class Stack[T]"}</code>. Type arguments are in square brackets too:
            {" "}<code>Box[number]</code>, <code>Stack[string]</code>.
        </p>
        <p>
            Calls do not mention type arguments: the compiler infers them from the arguments or from
            the expected type. The constraint <code>[T Named]</code> allows only fitting types and
            gives values of type <code>T</code> the members of <code>Named</code>. In JS the types
            are erased.
        </p>
        {example("generics")}
    </>
}

func modules() Node {
    return <>
        <p>
            Modules are ES modules: <code>import</code> and <code>export</code> as in JS. Imports of
            {" "}<code>.mango</code> modules are checked: the compiler reads their exports and knows
            their types.
        </p>
        <p>
            Types of npm packages, <code>.ts</code> files and Node modules (<code>node:fs</code>)
            come from TypeScript declarations: <code>readFileSync(path, "utf8")</code> is a
            {" "}<code>string</code>, and <code>request.url</code> of an
            {" "}<code>IncomingMessage</code> is a <code>?string</code>. A module without
            declarations is <code>any</code>. The playground works without the TypeScript compiler,
            so such imports are <code>any</code> here.
        </p>
        <p>
            <code>mango build</code> compiles a file together with every <code>.mango</code> module
            it imports and replaces <code>.mango</code> with <code>.js</code> in the paths. Next to
            each <code>.js</code> it writes a <code>.d.ts</code>, so TypeScript code can import the
            module with types. The playground on this page does not load modules, so the example
            below does not run.
        </p>
        {example("modules")}
    </>
}

func markup() Node {
    return <>
        <p>
            Markup is an ordinary expression: <code>&lt;a href="/"&gt;</code> creates a real
            {" "}<code>HTMLAnchorElement</code>, with no virtual DOM. The syntax is that of JSX, but
            attribute names are the HTML ones: <code>class</code>, not <code>className</code>.
            Types are checked as well: <code>&lt;input&gt;</code> is an
            {" "}<code>HTMLInputElement</code>, and <code>{"checked={1}"}</code> is an error.
        </p>
        <p>
            <code>on*</code> attributes hold code that runs on the event:
            {" "}<code>{"onClick={save()}"}</code> calls <code>save</code> on a click, not when the
            element is created. The variable <code>event</code> is available inside.
        </p>
        {example("markup")}
        <p>
            Inside <code>{"{...}"}</code> you can write ordinary <code>if</code>, <code>for</code>
            and <code>switch</code>: the elements in their blocks become the content.
        </p>
        {example("markup-flow")}
    </>
}

func components() Node {
    return <>
        <p>
            A component is declared with <code>comp</code> and used as a tag with a capital letter.
            Its parameters are its properties: they are checked like the arguments of a function,
            they can have default values, and <code>children Content</code> gets the markup between
            the tags. An object with the properties can be passed whole:
            {" "}<code>{"<Product {...product} />"}</code>.
        </p>
        <p>
            Components do not exist in JS: every use is replaced by the component's code. The
            {" "}<b>JavaScript</b> tab shows only the elements being created.
        </p>
        {example("components")}
        <p>
            A component can use itself, for a tree or nested comments. Such a component cannot be
            inlined, so it becomes a function, and every call of it has its own state. The recursion
            must end: the compiler accepts a use inside <code>{"{if ...}"}</code> or
            {" "}<code>{"{for ...}"}</code> or after an early <code>return</code>, but not an
            unconditional one. An early <code>return</code> picks the markup once, when the
            component is created.
        </p>
        {example("tree")}
    </>
}

func reactivity() Node {
    return <>
        <p>
            <code>state</code> declares a variable that the markup depends on. The compiler knows
            which parts of the markup read it and where it changes, and after each change it updates
            exactly those parts. There are no subscriptions and no DOM diffing, as the
            {" "}<b>JavaScript</b> tab shows.
        </p>
        {example("counter")}
        <p>
            <code>bind:value</code> and <code>bind:checked</code> bind an input to state both ways.
        </p>
        {example("bind")}
        <p>
            <code>{"{if ...}"}</code> and <code>{"{for ...}"}</code> update too. A branch is created
            again only when the condition changes, and the blocks of a list are found by the array
            item itself and moved, not created again.
        </p>
        {example("todos")}
    </>
}

func mounting() Node {
    return <>
        <p>
            <code>{"mount() { ... }"}</code> in a component's body is code that needs the markup on
            the page: starting a timer, listening to window events, setting the focus, measuring an
            element, loading data.
        </p>
        <p>
            <code>mount</code> runs <b>for every instance</b> of the component: with two
            {" "}<code>{"<Fruit />"}</code> in a list, it runs twice. And it runs <b>only when the
            markup is in the document</b>. That is checked after all the synchronous code that
            created the component, in a microtask: by then <code>document.body.append(...)</code>
            or an <code>{"{if}"}</code> branch has usually inserted the markup, and the browser has
            not drawn a frame yet, so <code>focus()</code> and measuring sizes work. Markup created
            earlier and inserted later, say in a timer, mounts when it is inserted.
        </p>
        {example("mount")}
        <p>
            If <code>mount</code> returns a function, it runs when <code>{"{if}"}</code>,
            {" "}<code>{"{switch}"}</code>, <code>{"{for}"}</code> or a <code>?:</code> branch in
            markup removes the component: that is where you stop what <code>mount</code> started.
            Press "Run", then hide the clock: the timer stops.
        </p>
        {example("mount-cleanup")}
        <ul>
            <li>
                The body of <code>mount</code> is a function that runs later, like an event
                handler: changes of <code>state</code> in it update the markup, and
                {" "}<code>return</code> returns from it, not from the component.
            </li>
            <li>
                It can return a function without parameters, <code>null</code> when there is
                nothing to stop, or nothing.
            </li>
            <li>
                <code>mount</code> is written at the top level of a component's body; there can be
                several, and they run in order.
            </li>
            <li>
                If <code>{"{if}"}</code>, <code>{"{switch}"}</code> or <code>{"{for}"}</code> removes
                the markup before it gets into the document, <code>mount</code> does not run.
            </li>
            <li>
                The compiler does not track markup that the program removes by itself
                (<code>element.remove()</code>): its cleanup does not run.
            </li>
            <li>
                To do something once for a whole list, write <code>mount</code> in the component
                that creates the list. Code needed once when the program starts goes simply after
                {" "}<code>document.body.append</code>.
            </li>
        </ul>
    </>
}

const COMMANDS = `npm run mango -- build app.mango            # app.js next to the source
npm run mango -- build src --out-dir dist   # every module of a folder
npm run mango -- run app.mango              # compile and run
npm run site:dev                            # this site on the Vite dev server
npm run vscode:install                      # syntax highlighting in VS Code`

func tools() Node {
    return <>
        <p>
            The compiler is written in TypeScript and runs on Node.js 24. The source code is in the
            {" "}<a href={REPOSITORY}>GitHub repository</a>; the commands run from its root:
        </p>
        <pre class="code">{COMMANDS}</pre>
        <p>
            The language specification with the reasons for its decisions is in
            {" "}<code>docs/spec.md</code>, the design of components in
            {" "}<code>docs/components.md</code>. This page is written in MangoScript too: its code
            is in <code>site/src</code>, and the server is <code>site/server.mango</code>.
        </p>
        <p>
            Vite projects have a plugin, <code>src/vite.ts</code>: with it <code>.mango</code>
            modules are imported like any others, and type errors show up over the page. This site
            is built that way.
        </p>
    </>
}
