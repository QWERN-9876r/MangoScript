// The English guide; the Russian one, ru/guide.mango, has the same sections. Each section is a
// component, which the page shows with <section.content />; the examples are files in
// site/examples.

import { example } from "../example.mango"
import { Callout } from "../../ui/callout.mango"
import { Card, CardGrid } from "../../ui/card.mango"
import { CodeBlock } from "../../ui/code-block.mango"
import { REPOSITORY, Section, text } from "../i18n.mango"
import { Components, Decorators, Markup, Mounting, Reactivity, Refs, Styles, WebComponents } from "./guide-components.mango"

export const SECTIONS []Section = [
    { id: "intro", title: "What is MangoScript", group: "Language", content: Intro },
    { id: "variables", title: "Variables and types", group: "Language", content: Variables },
    { id: "null", title: "null, unions and narrowing", group: "Language", content: NullSafety },
    { id: "functions", title: "Functions", group: "Language", content: Functions },
    { id: "errors", title: "Errors and defer", group: "Language", content: Errors },
    { id: "control", title: "Conditions and loops", group: "Language", content: Control },
    { id: "classes", title: "Classes and interfaces", group: "Language", content: Classes },
    { id: "generics", title: "Generics", group: "Language", content: Generics },
    { id: "modules", title: "Modules", group: "Language", content: Modules },
    { id: "markup", title: "Markup", group: "Markup and components", content: Markup },
    { id: "components", title: "Components", group: "Markup and components", content: Components },
    { id: "state", title: "State", group: "Markup and components", content: Reactivity },
    { id: "mount", title: "Mounting", group: "Markup and components", content: Mounting },
    { id: "ref", title: "Refs", group: "Markup and components", content: Refs },
    { id: "styles", title: "Styles", group: "Markup and components", content: Styles },
    { id: "web-components", title: "Web components", group: "Markup and components", content: WebComponents },
    { id: "decorators", title: "Decorators", group: "Markup and components", content: Decorators },
    { id: "tools", title: "Tools", group: "More", content: Tools },
]

comp Intro() {
    return <>
        <p>
            MangoScript is a language with the semantics of JavaScript, Go-style syntax and static
            types. It compiles to readable JavaScript without a runtime: what you write is what
            runs.
        </p>
        <CardGrid>
            <Card title="Like JavaScript" icon="layers">
                The same values, objects, arrays, classes and modules. Any JS library can be used.
            </Card>
            <Card title="Like Go" icon="code">
                <code>func</code>, the type after the name, several results, errors as a second
                value, <code>defer</code> and a single <code>for</code> loop.
            </Card>
            <Card title="Types" icon="shield">
                The compiler checks the program before it runs, <code>null</code> included: a
                {" "}<code>?User</code> cannot be used without a check.
            </Card>
            <Card title="Markup and components" icon="zap">
                <code>&lt;button&gt;</code> in code creates a real DOM element, and a component with
                {" "}<code>state</code> updates its markup by itself.
            </Card>
        </CardGrid>
        <p>
            Every example has a <b>JavaScript</b> tab with the code generated by the compiler, which
            runs right on this page. <b>Run</b> runs the example, and <b>Open in playground</b>
            {" "}opens it in the editor at the bottom of the page.
        </p>
        {example("hello")}
    </>
}

comp Variables() {
    return <>
        <p>
            Variables are declared as in JavaScript, with <code>let</code> and <code>const</code>,
            and the type goes after the name, as in Go. With a value, the type can be left out: the
            compiler infers it.
        </p>
        <p>
            A <code>let</code> without a value gets the zero value of its type, as in Go:
            {" "}<code>0</code>, <code>""</code>, <code>false</code>, an empty array or
            {" "}<code>null</code>.
        </p>
        {example("variables")}
        <table>
            <thead>
                <tr><th>Type</th><th>What it is</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>number</code>, <code>string</code>, <code>bool</code></td>
                    <td>numbers, strings and booleans</td>
                </tr>
                <tr><td><code>[]T</code></td><td>an array of values of type <code>T</code></td></tr>
                <tr><td><code>?T</code></td><td><code>T</code> or <code>null</code></td></tr>
                <tr>
                    <td><code>func(number) string</code></td>
                    <td>a function with a <code>number</code> parameter and a <code>string</code> result</td>
                </tr>
                <tr>
                    <td><code>(name string) =&gt; bool</code></td>
                    <td>the same kind of function type, written as an arrow</td>
                </tr>
                <tr>
                    <td><code>interface User {"{ ... }"}</code></td>
                    <td>an object with the listed fields and methods</td>
                </tr>
                <tr>
                    <td><code>{"{ [string]: number }"}</code></td>
                    <td>an object used as a map: any keys, <code>number</code> values</td>
                </tr>
                <tr><td><code>type ID number</code></td><td>another name for a type</td></tr>
                <tr><td><code>any</code></td><td>anything, unchecked: for example, values from JS</td></tr>
            </tbody>
        </table>
        {example("types")}
        <p>
            An object used as a map has the type <code>{"{ [string]: T }"}</code>: its keys can be
            any, and <code>delete prices.lychee</code> removes one. <code>value as Type</code> sees
            a value as a related type, for example what <code>JSON.parse</code> returns; unrelated
            types, such as <code>count as string</code>, are a compile error.
        </p>
        {example("maps")}
    </>
}

comp NullSafety() {
    return <>
        <p>
            A value of type <code>?T</code> may be <code>null</code>, and a value of type
            {" "}<code>T</code> may not. The fields of a <code>?T</code> cannot be used without a
            check: the error comes at compile time, not in the user's browser.
        </p>
        <p>
            After <code>if todo != null</code> the type narrows to <code>Todo</code>. The familiar
            {" "}<code>?.</code> and <code>??</code> work with <code>?T</code> too.
        </p>
        {example("null-safety")}
        <p>
            A type can be a union of several: <code>string | number</code>. The literal type
            {" "}<code>"all"</code> allows only that value, so
            {" "}<code>{'type Filter "all" | "active" | "done"'}</code> catches typos in strings.
            Unions narrow like <code>?T</code>: with <code>typeof</code>, <code>instanceof</code>, a
            comparison with a literal and <code>switch</code>.
        </p>
        {example("unions")}
    </>
}

comp Functions() {
    return <>
        <p>
            A function is declared with <code>func</code>. Parameters of the same type can be listed
            together, and a function can have several results, unpacked into several variables.
        </p>
        <p>
            Literals <code>{"func(x number) number { ... }"}</code> and arrow functions
            {" "}<code>x =&gt; x * 2</code> compile to JS arrow functions, so <code>this</code> in
            them is the one outside. Such a function in the initializer of a variable runs after
            the initializer, so it can use the variable: a recursive literal, or a callback that
            stops its own timer. If the type of the function depends on its body, as for
            {" "}<code>{"const f = () => f()"}</code>, the variable needs a written type.
        </p>
        {example("functions")}
    </>
}

comp Errors() {
    return <>
        <p>
            Ordinary errors need no exceptions: a function returns an error as its second value, and
            the caller checks it. An error is made with <code>error("...")</code>.
        </p>
        {example("errors")}
        <p>
            Exceptions from JS code are caught with <code>try</code> / <code>catch</code>.
            {" "}<code>defer</code> postpones a call until the function exits, which is handy for
            cleaning up: the call runs after a <code>return</code> and after an exception alike.
        </p>
        {example("defer")}
    </>
}

comp Control() {
    return <>
        <p>
            Conditions and loops are as in Go: no parentheses around the condition and always braces.
            There is one loop, <code>for</code>: over an array, with a condition, and the classic one
            with three parts. <code>switch</code> has no <code>break</code>: each case ends by itself.
        </p>
        {example("control")}
    </>
}

comp Classes() {
    return <>
        <p>
            Classes are as in TypeScript: typed fields, <code>constructor</code>,
            {" "}<code>extends</code>, the <code>private</code> and <code>protected</code> modifiers.
        </p>
        <p>
            Interfaces are structural: a class or an object fits if it has the fields and methods.
            {" "}<code>implements</code> only asks the compiler to check that where the class is
            declared.
        </p>
        {example("classes")}
    </>
}

comp Generics() {
    return <>
        <p>
            Type parameters go in square brackets, as in Go:
            {" "}<code>{"func last[T any](xs []T) ?T"}</code>, <code>{"interface Box[T]"}</code>,
            {" "}<code>{"class Stack[T]"}</code>. Type arguments are in square brackets too:
            {" "}<code>Box[number]</code>, <code>Stack[string]</code>.
        </p>
        <p>
            Calls do not mention type arguments: the compiler infers them from the arguments or from
            the expected type. The constraint <code>[T Named]</code> allows only fitting types and
            gives values of type <code>T</code> the members of <code>Named</code>. In JS the types
            are erased.
        </p>
        {example("generics")}
    </>
}

comp Modules() {
    return <>
        <p>
            Modules are ES modules: <code>import</code> and <code>export</code> as in JS. Imports of
            {" "}<code>.mango</code> modules are checked: the compiler reads their exports and knows
            their types.
        </p>
        <p>
            Types of npm packages, <code>.ts</code> files and Node modules (<code>node:fs</code>)
            come from TypeScript declarations: <code>readFileSync(path, "utf8")</code> is a
            {" "}<code>string</code>, and <code>request.url</code> of an
            {" "}<code>IncomingMessage</code> is a <code>?string</code>. A module without
            declarations is <code>any</code>. The playground works without the TypeScript compiler,
            so such imports are <code>any</code> here.
        </p>
        <p>
            <code>mango build</code> compiles a file together with every <code>.mango</code> module
            it imports and replaces <code>.mango</code> with <code>.js</code> in the paths. Next to
            each <code>.js</code> it writes a <code>.d.ts</code>, so TypeScript code can import the
            module with types.
        </p>
        <Callout kind="note">
            The playground on this page does not load modules, so the example below does not run.
        </Callout>
        {example("modules")}
    </>
}

const COMMANDS = `npm install --save-dev mangoscript
npx mango build app.mango            # app.js next to the source
npx mango build src --out-dir dist   # every module of a folder
npx mango run app.mango              # compile and run`

const REPOSITORY_COMMANDS = `npm run site:dev         # this site on the Vite dev server
npm run vscode:install   # syntax highlighting in VS Code`

comp Tools() {
    return <>
        <p>
            The compiler is the npm package <code>mangoscript</code>, and it runs on Node.js 24:
        </p>
        <CodeBlock
            code={COMMANDS}
            label={text().terminal}
            copyLabel={text().copy}
            copiedLabel={text().copied}
        >
            {COMMANDS}
        </CodeBlock>
        <p>
            Vite projects have a plugin, <code>mangoscript/vite</code>: with it <code>.mango</code>
            modules are imported like any others, and type errors show up over the page. This site
            is built that way.
        </p>
        <p>
            The compiler is written in TypeScript; the source code is in the
            {" "}<a href={REPOSITORY}>GitHub repository</a>. The language specification with the
            reasons for its decisions is in <code>docs/spec.md</code>, the design of components in
            {" "}<code>docs/components.md</code>. This page is written in MangoScript too: its code
            is in <code>site/src</code>, and the server is <code>site/server.mango</code>. From the
            root of the repository:
        </p>
        <CodeBlock
            code={REPOSITORY_COMMANDS}
            label={text().terminal}
            copyLabel={text().copy}
            copiedLabel={text().copied}
        >
            {REPOSITORY_COMMANDS}
        </CodeBlock>
    </>
}
