{
  "name": "rooklang",
  "version": "0.3.1",
  "description": "A language with JavaScript semantics, Go-style syntax, goroutines on real threads and static types that compiles to readable JavaScript",
  "keywords": [
    "rooklang",
    "programming-language",
    "compiler",
    "javascript",
    "static-typing",
    "go",
    "goroutines",
    "channels",
    "concurrency",
    "web-workers",
    "vite-plugin",
    "web-components"
  ],
  "homepage": "https://qwern-9876r.github.io/RookLang/",
  "bugs": "https://github.com/QWERN-9876r/RookLang/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QWERN-9876r/RookLang.git"
  },
  "license": "MIT",
  "author": "Qwern9876r",
  "type": "module",
  "rook": {
    "markup": true
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "rook": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "rook": "node src/cli.ts",
    "site:dev": "vite",
    "site:build": "vite build",
    "site": "npm run site:build && node src/cli.ts run site/server.rk",
    "site:images": "node scripts/og-image.ts",
    "vscode:build": "node scripts/build-vscode.ts",
    "vscode:package": "npm run vscode:build && cd editors/vscode && npx --yes @vscode/vsce@4 package --no-dependencies --baseContentUrl https://github.com/QWERN-9876r/RookLang/blob/HEAD/editors/vscode --baseImagesUrl https://github.com/QWERN-9876r/RookLang/raw/HEAD/editors/vscode --out rooklang.vsix",
    "vscode:install": "npm run vscode:package && code --install-extension editors/vscode/rooklang.vsix --force",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix --fix-type layout .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "@types/vscode": "~1.91.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
