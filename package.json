{
  "name": "mangoscript",
  "version": "0.1.0",
  "description": "A language with JavaScript semantics, Go-style syntax and static types that compiles to readable JavaScript",
  "keywords": [
    "mangoscript",
    "programming-language",
    "compiler",
    "javascript",
    "static-typing",
    "go",
    "vite-plugin",
    "web-components"
  ],
  "homepage": "https://qwern-9876r.github.io/MangoScript/",
  "bugs": "https://github.com/QWERN-9876r/MangoScript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QWERN-9876r/MangoScript.git"
  },
  "license": "MIT",
  "author": "Qwern9876r",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mango": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "mango": "node src/cli.ts",
    "site:dev": "vite",
    "site:build": "vite build",
    "site": "npm run site:build && node src/cli.ts run site/server.mango",
    "vscode:package": "cd editors/vscode && npx --yes @vscode/vsce@4 package --allow-missing-repository --skip-license --out mangoscript.vsix",
    "vscode:install": "npm run vscode:package && code --install-extension editors/vscode/mangoscript.vsix --force",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
