{
  "name": "mangoscript",
  "version": "0.0.1",
  "private": true,
  "description": "MangoScript — a programming language that compiles to JavaScript",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mango": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "mango": "node src/cli.ts",
    "site:build": "tsc -p tsconfig.site.json && node src/cli.ts build site/src --out-dir site/dist",
    "site": "npm run site:build && node src/cli.ts run site/server.mango",
    "vscode:package": "cd editors/vscode && npx --yes @vscode/vsce@4 package --allow-missing-repository --skip-license --out mangoscript.vsix",
    "vscode:install": "npm run vscode:package && code --install-extension editors/vscode/mangoscript.vsix --force",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
