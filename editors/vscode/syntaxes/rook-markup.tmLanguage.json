{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rook markup",
  "comment": "Markup in Rook code: tags, attributes, text and {...}. The main grammar, rook.tmLanguage.json, includes it where a value is expected.",
  "scopeName": "source.rook.markup",
  "patterns": [{ "include": "#markup" }],
  "repository": {
    "markup": {
      "comment": "An element where a value is expected. `<` after a value (a name, `)` or `]`, with at most one space between) is a comparison, unless the name is a keyword such as `return`; so is `<` followed by a space.",
      "begin": "(?:(?<=\\breturn\\s|\\bthrow\\s|\\bcase\\s|\\bin\\s)|(?<![\\w$)\\]])(?<![\\w$)\\]]\\s))(?=<(?:[A-Za-z_$][\\w$\\-:.]*(?=[\\s/>{]|$)|>))",
      "end": "(/>)|(?:(</)([A-Za-z_$][\\w$\\-:.]*)?\\s*(>))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.rook" },
        "2": { "name": "punctuation.definition.tag.begin.rook" },
        "3": { "patterns": [{ "include": "#markup-tag-name" }] },
        "4": { "name": "punctuation.definition.tag.end.rook" }
      },
      "patterns": [{ "include": "#markup-open-tag" }, { "include": "#markup-content" }]
    },

    "markup-child": {
      "comment": "An element among the children of another one, where `<` always starts a tag.",
      "begin": "(?=<(?:[A-Za-z_$]|>))",
      "end": "(/>)|(?:(</)([A-Za-z_$][\\w$\\-:.]*)?\\s*(>))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.rook" },
        "2": { "name": "punctuation.definition.tag.begin.rook" },
        "3": { "patterns": [{ "include": "#markup-tag-name" }] },
        "4": { "name": "punctuation.definition.tag.end.rook" }
      },
      "patterns": [{ "include": "#markup-open-tag" }, { "include": "#markup-content" }]
    },

    "markup-open-tag": {
      "name": "meta.tag.rook",
      "begin": "(<)([A-Za-z_$][\\w$\\-:.]*)?",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.rook" },
        "2": { "patterns": [{ "include": "#markup-tag-name" }] }
      },
      "end": "(?=/?>)",
      "patterns": [{ "include": "#markup-attributes" }]
    },

    "markup-content": {
      "begin": ">",
      "beginCaptures": { "0": { "name": "punctuation.definition.tag.end.rook" } },
      "end": "(?=</)",
      "contentName": "meta.jsx.children.rook",
      "patterns": [
        { "include": "#markup-child" },
        { "include": "#markup-expression" },
        { "include": "#markup-entity" }
      ]
    },

    "markup-tag-name": {
      "patterns": [
        { "name": "support.class.component.rook", "match": "[A-Z][\\w$.]*" },
        {
          "comment": "<section.content />: a component taken from a value.",
          "name": "support.class.component.rook",
          "match": "[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)+(?![\\w$\\-:])"
        },
        { "name": "entity.name.tag.rook", "match": "[A-Za-z_$][\\w$\\-:.]*" }
      ]
    },

    "markup-attributes": {
      "patterns": [
        { "include": "source.rook#comments" },
        { "include": "#markup-expression" },
        {
          "match": "(bind)(:)([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.namespace.rook" },
            "2": { "name": "punctuation.separator.namespace.rook" },
            "3": { "name": "entity.other.attribute-name.rook" }
          }
        },
        { "name": "entity.other.attribute-name.rook", "match": "[A-Za-z_$][\\w$\\-:.]*" },
        { "name": "keyword.operator.assignment.rook", "match": "=" },
        {
          "name": "string.quoted.double.rook",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.rook" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.rook" } },
          "patterns": [{ "include": "#markup-entity" }]
        },
        {
          "name": "string.quoted.single.rook",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.rook" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.rook" } },
          "patterns": [{ "include": "#markup-entity" }]
        }
      ]
    },

    "markup-expression": {
      "comment": "`{value}`, `{...attrs}`, handler code and `{if ...}` / `{for ...}` blocks.",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.rook" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.rook" } },
      "contentName": "meta.embedded.expression.rook",
      "patterns": [{ "include": "source.rook#statements" }]
    },

    "markup-entity": {
      "name": "constant.character.entity.rook",
      "match": "&(?:[A-Za-z][A-Za-z0-9]*|#[0-9]+|#x[0-9A-Fa-f]+);"
    }
  }
}
