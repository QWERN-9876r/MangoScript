{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MangoScript styles",
  "scopeName": "source.mango.css",
  "patterns": [
    {
      "include": "#style"
    }
  ],
  "repository": {
    "style": {
      "comment": "`style { ... }` at the start of a statement in a component: CSS with `{value}` from code in declarations.",
      "begin": "^\\s*(style)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.style.mango"
        },
        "2": {
          "name": "punctuation.section.block.begin.mango"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.mango"
        }
      },
      "contentName": "source.css.embedded.mango",
      "patterns": [
        {
          "include": "#css-body"
        }
      ]
    },
    "css-body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#at-rule"
        },
        {
          "include": "#declaration"
        },
        {
          "include": "#block"
        },
        {
          "include": "#selector"
        }
      ]
    },
    "comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.css.mango"
    },
    "at-rule": {
      "match": "@[\\w-]+",
      "name": "keyword.control.at-rule.css.mango"
    },
    "block": {
      "comment": "The block of a rule; nested braces keep the `}` of the style block apart.",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.property-list.begin.css.mango"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.property-list.end.css.mango"
        }
      },
      "patterns": [
        {
          "include": "#css-body"
        }
      ]
    },
    "declaration": {
      "comment": "`name:` followed by a space or a value is a declaration, as in the compiler; `a:hover` is a selector.",
      "begin": "(--[\\w-]+|-?[A-Za-z_][\\w-]*)\\s*(:)(?=\\s|[^\\w\\-:\\\\]|$)",
      "beginCaptures": {
        "1": {
          "name": "support.type.property-name.css.mango"
        },
        "2": {
          "name": "punctuation.separator.key-value.css.mango"
        }
      },
      "end": ";|(?=\\})",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.rule.css.mango"
        }
      },
      "patterns": [
        {
          "include": "#value-from-code"
        },
        {
          "include": "#comment"
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
          "name": "string.quoted.css.mango"
        },
        {
          "match": "!important\\b",
          "name": "keyword.other.important.css.mango"
        },
        {
          "match": "#[0-9a-fA-F]{3,8}\\b",
          "name": "constant.other.color.rgb-value.hex.css.mango"
        },
        {
          "match": "[\\w-]+(?=\\()",
          "name": "support.function.misc.css.mango"
        },
        {
          "match": "-?(?:\\d*\\.)?\\d+(?:[a-zA-Z]+|%)?",
          "name": "constant.numeric.css.mango"
        },
        {
          "match": "--[\\w-]+",
          "name": "variable.css.mango"
        },
        {
          "match": "[A-Za-z][\\w-]*",
          "name": "support.constant.property-value.css.mango"
        }
      ]
    },
    "value-from-code": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.mango"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.mango"
        }
      },
      "contentName": "meta.embedded.expression.mango",
      "patterns": [
        {
          "include": "source.mango#statements"
        }
      ]
    },
    "selector": {
      "patterns": [
        {
          "match": "\\.[\\w-]+",
          "name": "entity.other.attribute-name.class.css.mango"
        },
        {
          "match": "#[\\w-]+",
          "name": "entity.other.attribute-name.id.css.mango"
        },
        {
          "match": "::?[\\w-]+",
          "name": "entity.other.attribute-name.pseudo-class.css.mango"
        },
        {
          "match": "&",
          "name": "entity.name.tag.nesting.css.mango"
        },
        {
          "match": "[A-Za-z][\\w-]*|\\*",
          "name": "entity.name.tag.css.mango"
        },
        {
          "match": "[>+~,]",
          "name": "keyword.operator.combinator.css.mango"
        }
      ]
    }
  }
}
