{
  "name": "rooklang",
  "displayName": "Rook",
  "description": "Rook support: highlighting, errors as you type and completion",
  "version": "0.1.0",
  "publisher": "rooklang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QWERN-9876r/RookLang.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:rook"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rook",
        "aliases": [
          "Rook",
          "rook"
        ],
        "extensions": [
          ".rk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rook.webp",
          "dark": "./icons/rook.webp"
        }
      }
    ],
    "grammars": [
      {
        "language": "rook",
        "scopeName": "source.rook",
        "path": "./syntaxes/rook.tmLanguage.json"
      },
      {
        "scopeName": "source.rook.markup",
        "path": "./syntaxes/rook-markup.tmLanguage.json"
      },
      {
        "scopeName": "source.rook.css",
        "path": "./syntaxes/rook-css.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[rook]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  }
}
