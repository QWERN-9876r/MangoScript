{
  "name": "mangoscript",
  "displayName": "MangoScript",
  "description": "MangoScript support: highlighting, errors as you type and completion",
  "version": "0.1.0",
  "publisher": "mangoscript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QWERN-9876r/MangoScript.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:mangoscript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mangoscript",
        "aliases": [
          "MangoScript",
          "mango"
        ],
        "extensions": [
          ".mango"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mango.svg",
          "dark": "./icons/mango.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mangoscript",
        "scopeName": "source.mango",
        "path": "./syntaxes/mangoscript.tmLanguage.json"
      },
      {
        "scopeName": "source.mango.markup",
        "path": "./syntaxes/mangoscript-markup.tmLanguage.json"
      },
      {
        "scopeName": "source.mango.css",
        "path": "./syntaxes/mangoscript-css.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[mangoscript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  }
}
