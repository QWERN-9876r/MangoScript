{
  "name": "rooklang",
  "displayName": "Rook Language",
  "description": "Rook support: highlighting, errors as you type and completion",
  "version": "0.1.0",
  "publisher": "Qwern9876r",
  "preview": true,
  "icon": "icons/rook.png",
  "license": "MIT",
  "homepage": "https://qwern-9876r.github.io/RookLang/",
  "bugs": {
    "url": "https://github.com/QWERN-9876r/RookLang/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/QWERN-9876r/RookLang.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "rook",
    "rk",
    "go",
    "javascript",
    "static types",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:rook"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rook",
        "aliases": [
          "Rook",
          "rook"
        ],
        "extensions": [
          ".rk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rook.png",
          "dark": "./icons/rook.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "rook",
        "scopeName": "source.rook",
        "path": "./syntaxes/rook.tmLanguage.json"
      },
      {
        "scopeName": "source.rook.markup",
        "path": "./syntaxes/rook-markup.tmLanguage.json"
      },
      {
        "scopeName": "source.rook.css",
        "path": "./syntaxes/rook-css.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[rook]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  }
}
